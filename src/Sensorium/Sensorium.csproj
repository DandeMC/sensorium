<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sensorium</RootNamespace>
    <AssemblyName>Sensorium</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Sensorium</Product>
    <Description>Sensor-Panel für Windows: PC-Werte und Home Assistant auf einem zweiten Bildschirm</Description>
    <Authors>DandeMC</Authors>
    <Copyright>© 2026 DandeMC</Copyright>
    <ApplicationIcon>Assets\Sensorium.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Profiles\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Das WebView2-Paket bindet immer auch seine WPF-Bibliothek ein; Sensorium nutzt nur WinForms. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
