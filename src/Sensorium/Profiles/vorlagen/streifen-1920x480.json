{
  "name": "Streifen",
  "description": "Schmale Leiste, z. B. 8,8- oder 12,3-Zoll-Displays",
  "version": 3,
  "canvas": { "width": 1920, "height": 480 },
  "theme": {
    "locale": "de-DE",
    "background": "aurora",
    "colors": {
      "bg": "#05090f",
      "text": "#e9f1f8",
      "muted": "#8596ab",
      "dim": "#4f5d70",
      "line": "rgba(140,190,255,.085)",
      "track": "rgba(255,255,255,.065)",
      "accent": "#38d2ef",
      "accent2": "#6d8cff",
      "up": "#a08cff",
      "warn": "#ffb446",
      "crit": "#ff5876",
      "ok": "#4fe0a0"
    },
    "gradients": { "accent": ["#22c3ec", "#6d8cff"], "warn": ["#ffd060", "#ff8a3d"], "crit": ["#ff8a96", "#ff3d6e"], "ok": ["#5ff0b0", "#2bbf8a"], "up": ["#b9a6ff", "#8a6cff"] },
    "fonts": { "num": "Bahnschrift, 'Segoe UI', sans-serif", "ui": "'Segoe UI Variable Text', 'Segoe UI', sans-serif" }
  },
  "formulas": {
    "pc.wall.cost": { "label": "PC heute (Cent)", "expr": "pc.wall.today * strom.preis.ct" },
    "pc.rest": { "label": "PC ohne CPU und GPU", "expr": "pos(pc.wall - cpu.power - gpu.power)" }
  },
  "switcher": { "y": 460 },
  "autoPage": [
    {
      "when": { "sensor": "fps.current", "gt": 0 },
      "page": "pc"
    }
  ],
  "pages": [
    {
      "id": "pc",
      "name": "PC-Übersicht",
      "short": "PC",
      "widgets": [
        {
          "type": "card",
          "x": 24,
          "y": 24,
          "w": 340,
          "h": 200,
          "children": [
            { "type": "clock", "x": 26, "y": 14, "w": 300, "h": 90, "show": "time", "size": 84 },
            { "type": "clock", "x": 30, "y": 108, "w": 290, "h": 24, "show": "date" },
            {
              "type": "status",
              "x": 28,
              "y": 152,
              "w": 290,
              "h": 22,
              "align": "left",
              "checks": [
                { "sensor": "cpu.temp", "warn": 70, "crit": 85, "label": "CPU-Temperatur" },
                { "sensor": "gpu.temp", "warn": 75, "crit": 85, "label": "GPU-Temperatur" },
                { "sensor": "gpu.hotspot", "warn": 90, "crit": 100, "label": "GPU-Hotspot" },
                { "sensor": "cooler.liquid", "warn": 40, "crit": 45, "label": "Kühlmittel" },
                { "sensor": "drive.C.temp", "warn": 60, "crit": 70, "label": "Laufwerk C:" }
              ],
              "activeIf": { "sensor": "fps.current", "gt": 0 },
              "activeText": "Spielmodus",
              "okText": "Alles normal"
            }
          ]
        },
        {
          "type": "card",
          "x": 24,
          "y": 244,
          "w": 340,
          "h": 212,
          "label": "Netzwerk",
          "meta": "{sys.net.speed}",
          "children": [
            { "type": "box", "x": 170, "y": 66, "w": 1, "h": 56, "fill": "@line" },
            { "type": "label", "x": 28, "y": 64, "w": 130, "h": 16, "text": "Download", "icon": "down", "color": "@accent" },
            { "type": "value", "x": 28, "y": 80, "w": 140, "h": 44, "sensor": "sys.net.down", "format": "rate", "size": 32, "unitSize": 15 },
            { "type": "label", "x": 190, "y": 64, "w": 130, "h": 16, "text": "Upload", "icon": "up", "color": "@up" },
            { "type": "value", "x": 190, "y": 80, "w": 140, "h": 44, "sensor": "sys.net.up", "format": "rate", "size": 32, "unitSize": 15 },
            { "type": "spark", "x": 0, "y": 152, "w": 170, "h": 60, "sensor": "sys.net.down", "color": "@accent", "fill": 0.2 },
            { "type": "spark", "x": 170, "y": 152, "w": 170, "h": 60, "sensor": "sys.net.up", "color": "@up", "fill": 0.2 }
          ]
        },
        {
          "type": "card",
          "x": 384,
          "y": 24,
          "w": 560,
          "h": 432,
          "label": "Prozessor",
          "meta": "{cpu.name}",
          "children": [
            {
              "type": "gauge",
              "x": 4,
              "y": 58,
              "w": 276,
              "h": 240,
              "sensor": "cpu.temp",
              "label": "Temperatur",
              "unit": "°C",
              "min": 20,
              "max": 100,
              "rules": [
                { "from": 70, "color": "@warn" },
                { "from": 85, "color": "@crit", "pulse": true }
              ]
            },
            {
              "type": "metric",
              "x": 296,
              "y": 64,
              "w": 236,
              "h": 62,
              "label": "Auslastung",
              "sensor": "cpu.load",
              "unit": "%",
              "max": 100,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22
            },
            {
              "type": "metric",
              "x": 296,
              "y": 142,
              "w": 236,
              "h": 62,
              "label": "Takt",
              "sensor": "cpu.clock",
              "unit": "GHz",
              "max": 5.2,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22,
              "scale": 0.001,
              "decimals": 2
            },
            {
              "type": "metric",
              "x": 296,
              "y": 220,
              "w": 236,
              "h": 62,
              "label": "Leistung",
              "sensor": "cpu.power",
              "unit": "W",
              "max": 200,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22,
              "decimals": 1
            },
            { "type": "label", "x": 28, "y": 318, "w": 200, "h": 14, "text": "Threads" },
            { "type": "text", "x": 232, "y": 313, "w": 300, "h": 22, "text": "Heißester Kern {cpu.temp.max:0} °C", "emph": true, "size": 13, "align": "right" },
            { "type": "threads", "x": 28, "y": 342, "w": 504, "h": 40, "sensor": "cpu.threads", "warnAt": 85 }
          ]
        },
        {
          "type": "card",
          "x": 964,
          "y": 24,
          "w": 560,
          "h": 432,
          "label": "Grafikkarte",
          "meta": "{gpu.name}",
          "children": [
            {
              "type": "gauge",
              "x": 4,
              "y": 58,
              "w": 276,
              "h": 240,
              "sensor": "gpu.temp",
              "label": "Temperatur",
              "unit": "°C",
              "min": 20,
              "max": 100,
              "rules": [
                { "from": 75, "color": "@warn" },
                { "from": 85, "color": "@crit", "pulse": true }
              ]
            },
            {
              "type": "metric",
              "x": 296,
              "y": 64,
              "w": 236,
              "h": 62,
              "label": "Auslastung",
              "sensor": "gpu.load",
              "unit": "%",
              "max": 100,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22
            },
            {
              "type": "metric",
              "x": 296,
              "y": 142,
              "w": 236,
              "h": 62,
              "label": "Takt",
              "sensor": "gpu.clock",
              "unit": "MHz",
              "max": 3000,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22
            },
            {
              "type": "metric",
              "x": 296,
              "y": 220,
              "w": 236,
              "h": 62,
              "label": "Leistung",
              "sensor": "gpu.power",
              "unit": "W",
              "max": 300,
              "size": 28,
              "unitSize": 15,
              "sparkY": 34,
              "sparkH": 22,
              "decimals": 1
            },
            { "type": "label", "x": 28, "y": 318, "w": 200, "h": 14, "text": "Grafikspeicher" },
            { "type": "text", "x": 232, "y": 313, "w": 300, "h": 22, "text": "{gpu.vram.used:1} / {gpu.vram.total:0} GB", "emph": true, "size": 13, "align": "right" },
            { "type": "bar", "x": 28, "y": 343, "w": 504, "h": 10, "sensor": "gpu.vram.used", "max": "gpu.vram.total" },
            { "type": "text", "x": 28, "y": 364, "w": 160, "h": 22, "text": "Hotspot {gpu.hotspot:0} °C", "emph": true, "size": 13 },
            { "type": "text", "x": 190, "y": 364, "w": 200, "h": 22, "text": "Lüfter {gpu.fan:0} RPM", "emph": true, "size": 13 }
          ]
        },
        {
          "type": "card",
          "x": 1544,
          "y": 24,
          "w": 352,
          "h": 200,
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": 0,
              "w": 352,
              "h": 200,
              "visibleIf": { "sensor": "pc.wall", "exists": true },
              "hiddenIf": { "sensor": "fps.current", "gt": 0 },
              "children": [
                { "type": "header", "x": 28, "y": 26, "w": 200, "h": 14, "text": "Leistung" },
                { "type": "text", "x": 124, "y": 24, "w": 200, "h": 18, "text": "an der Steckdose", "align": "right" },
                { "type": "value", "x": 28, "y": 50, "w": 240, "h": 76, "sensor": "pc.wall", "unit": "W", "size": 60, "unitSize": 20, "unitGap": 8 },
                { "type": "spark", "x": 28, "y": 140, "w": 296, "h": 40, "sensor": "pc.wall", "color": "@accent", "grid": true, "fill": 0.24 }
              ]
            },
            {
              "type": "group",
              "x": 0,
              "y": 0,
              "w": 352,
              "h": 200,
              "visibleIf": { "sensor": "pc.wall", "exists": false },
              "hiddenIf": { "sensor": "fps.current", "gt": 0 },
              "children": [
                { "type": "header", "x": 28, "y": 26, "w": 200, "h": 14, "text": "Leistung" },
                { "type": "text", "x": 124, "y": 24, "w": 200, "h": 18, "text": "CPU + GPU", "align": "right" },
                { "type": "value", "x": 28, "y": 50, "w": 240, "h": 76, "sensor": "power.total", "unit": "W", "size": 60, "unitSize": 20, "unitGap": 8 },
                { "type": "spark", "x": 28, "y": 140, "w": 296, "h": 40, "sensor": "power.total", "color": "@accent", "grid": true, "fill": 0.24 }
              ]
            },
            {
              "type": "group",
              "x": 0,
              "y": 0,
              "w": 352,
              "h": 200,
              "visibleIf": { "sensor": "fps.current", "gt": 0 },
              "children": [
                { "type": "header", "x": 28, "y": 26, "w": 200, "h": 14, "text": "Framerate", "color": "@ok" },
                { "type": "text", "x": 84, "y": 24, "w": 240, "h": 18, "text": "Ø {fps.current:0|avgpos} · {fps.frametime:1} ms", "emph": true, "align": "right" },
                { "type": "value", "x": 28, "y": 50, "w": 240, "h": 76, "sensor": "fps.current", "unit": "FPS", "size": 60, "unitSize": 18, "unitGap": 8 },
                { "type": "spark", "x": 28, "y": 140, "w": 296, "h": 40, "sensor": "fps.current", "color": "@ok", "grid": true, "fill": 0.24 }
              ]
            }
          ]
        },
        {
          "type": "card",
          "x": 1544,
          "y": 244,
          "w": 352,
          "h": 212,
          "label": "Speicher",
          "meta": "{sys.ram.info}",
          "children": [
            { "type": "label", "x": 28, "y": 66, "w": 160, "h": 14, "text": "Arbeitsspeicher" },
            { "type": "text", "x": 150, "y": 61, "w": 174, "h": 22, "text": "{sys.ram.used:1} / {sys.ram.total:0} GB", "emph": true, "size": 13, "align": "right" },
            { "type": "bar", "x": 28, "y": 88, "w": 296, "h": 8, "sensor": "sys.ram.pct", "max": 100 },
            { "type": "label", "x": 28, "y": 120, "w": 160, "h": 14, "text": "Laufwerk C:" },
            { "type": "text", "x": 150, "y": 115, "w": 174, "h": 22, "text": "{sys.drive.C.pct:0} % belegt", "emph": true, "size": 13, "align": "right" },
            { "type": "bar", "x": 28, "y": 142, "w": 296, "h": 8, "sensor": "sys.drive.C.pct", "max": 100 },
            { "type": "text", "x": 28, "y": 168, "w": 296, "h": 22, "text": "Laufzeit {sys.uptime|dur}", "size": 13 }
          ]
        }
      ]
    }
  ]
}
